# Application Settings
APP_ENV=development
LOG_LEVEL=INFO

# LLM Provider: 'groq' (high-speed 70B), 'ollama' (100% offline local), 'openai', 'openrouter'
LLM_PROVIDER=groq

# Groq Cloud Settings (llama-3.3-70b-versatile)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# OpenAI Cloud Settings (optional)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# OpenRouter Settings (optional)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct

# Local LLM Fallback & Vector Embeddings (Ollama)
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=llama3.2:3b
EMBEDDING_MODEL=nomic-embed-text

# PostgreSQL Database Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5434
POSTGRES_DB=assistant_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_password

# Qdrant Vector Database
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION_NAME=company_documents
